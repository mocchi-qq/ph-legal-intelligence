{
  "name": "ph-legal-intelligence",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter=@phli/web dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter=database db:generate",
    "db:migrate": "pnpm --filter=database db:migrate",
    "db:seed": "pnpm --filter=database db:seed"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}